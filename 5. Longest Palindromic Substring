class Solution:
    def longestPalindrome(self, s: str) -> str:
        def ert(left,right):
            while left>=0 and right<len(s) and s[left]==s[right]:
                left-=1
                right+=1
            return left+1,right-1
        start=0
        lon=0
        for i in range(len(s)):
            l1,r1=ert(i,i)
            l2,r2=ert(i,i+1)
            if (r1-l1)+1>lon:
                lon=(r1-l1)+1
                start=l1
            if (r2-l2)+1>lon:
                lon=(r2-l2)+1
                start=l2
        return s[start:start+lon]
        
