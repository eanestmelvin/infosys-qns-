class Solution:
    def longestCommonSubsequence(self, text1: str, text2: str) -> int:
        l=len(text1)
        b=len(text2)
        dp=[[0]*(b+1) for i in range(l+1)]
        for i in range(1,l+1):
            for j in range(1,b+1):
                if text1[i-1]==text2[j-1]:
                    dp[i][j]=dp[i-1][j-1] + 1
                else:
                    dp[i][j]=max(dp[i-1][j],dp[i][j-1])
        return dp[l][b]
