class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        if not s:
            return 0
        l=0
        lon=1
        sett=set()
        for r in range(len(s)):
            while(s[r] in sett):
                sett.remove(s[l])
                l+=1
            sett.add(s[r])
            w=(r-l)+1
            lon=max(lon,w)
        return lon
